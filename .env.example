# Copy to .env.local and fill in. See README.md → Environment variables.

# Neon connection string (pooled). Leave empty to use a local PGlite database in ./.pglite
DATABASE_URL=

# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare R2 (private bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Resend (domain must be verified). Leave empty in dev to print emails to the console.
RESEND_API_KEY=
EMAIL_FROM="DentalKeep <reminders@yourdomain.com>"

# Vercel Cron sends this as a Bearer token to /api/cron/reminders
CRON_SECRET=

# Used once by `pnpm db:seed` to create the admin account
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
